# Solar-scraper configuration
# Copy this file to .env and fill in the required values.

# MongoDB connection string for HOST tooling (manage_keys.py, dev.py).
# The compose app builds its own URI from MONGO_APP_USER/PASSWORD (service
# name `mongo` instead of 127.0.0.1).
MONGO_URI=mongodb://APP_USER:APP_PASSWORD@127.0.0.1:27017/solar_scraper?authSource=solar_scraper

# Root/admin Mongo user. Creates the admin user on a FRESH mongo-data volume
# (no effect on an existing one) and is used by the container healthcheck.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT

# Least-privilege Mongo user (readWrite on solar_scraper only). Used by the
# app, dev.py and manage_keys.py. On a fresh volume mongo-init.js creates it
# automatically; on an existing volume create it manually (see README).
# Keep passwords alphanumeric only — special chars break the URI/compose
# interpolation. Example: openssl rand -hex 24
MONGO_APP_USER=solar_scraper
MONGO_APP_PASSWORD=CHANGE_ME_APP

# Output API URL (required for production use)
OUTPUT_API_URL=

# Output API token (optional)
OUTPUT_API_TOKEN=

# Worker identifier (unique per container)
WORKER_ID=worker-1

# Fernet key for encrypting credentials at rest (GDPR Art. 32).
# Generate with: openssl rand -base64 32
# Back it up with the backups in ./backups/ — a lost key makes all stored
# credentials unrecoverable.
ENCRYPTION_KEY=CHANGE_ME_ENC

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# How long to keep raw API responses in MongoDB (days)
RAW_TTL_DAYS=30

# How long records are kept in MongoDB after delivery to the output API (days).
# `inf` keeps them forever. Undelivered records are never deleted.
POSTED_TTL_DAYS=7

# Max threads for growattServer.to_thread calls
THREADPOOL_WORKERS=32

# Lease expiry = interval_seconds × this value
LEASE_TTL_MULTIPLIER=2

# Seconds between heartbeat renewals
LEASE_RENEWAL_INTERVAL=30

# On SIGTERM, seconds running jobs may take to finish before being cancelled.
# The compose stop_grace_period must cover it (see config.py).
SHUTDOWN_TIMEOUT_SECONDS=50
