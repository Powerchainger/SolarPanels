# Solar-scraper configuration
# Copy this file to .env and fill in the required values.

# MongoDB connection string
MONGO_URI=mongodb://mongo:27017

# Output API URL (required for production use)
OUTPUT_API_URL=

# Output API token (optional)
OUTPUT_API_TOKEN=

# Worker identifier (unique per container)
WORKER_ID=worker-1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# How long to keep raw API responses in MongoDB (days)
RAW_TTL_DAYS=30

# Max threads for growattServer.to_thread calls
THREADPOOL_WORKERS=32

# Lease expiry = interval_seconds × this value
LEASE_TTL_MULTIPLIER=2

# Seconds between heartbeat renewals
LEASE_RENEWAL_INTERVAL=30
